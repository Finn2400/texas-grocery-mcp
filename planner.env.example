# Find the numeric ID with store_search, then set it here.
# HEB_DEFAULT_STORE=123
# HEB_DEFAULT_SHOPPING_LIST=This Week
HEB_WRITE_SCOPE=read-only

# Optional reviewed queue produced by the companion grocery planner.
# PLANNER_IMPORT_PACK_PATH=/absolute/path/to/heb_list_import_pack.json

AUTH_STATE_PATH=~/.texas-grocery-mcp/auth.json
REESE84_KEEPWARM_INTERVAL_S=0
AUTO_REFRESH_ENABLED=false
AUTO_REFRESH_ON_STARTUP=false
HASH_SELF_HEAL_ENABLED=false
LOG_LEVEL=INFO
